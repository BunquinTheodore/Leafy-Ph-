# API local env. The repo root .env.example documents every variable; this is a convenience
# subset for running the API directly with `uv run uvicorn app.main:app --reload`.
DATABASE_URL=postgresql+asyncpg://leafy:change-me-dev-only@localhost:5433/leafy
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
ML_SERVICE=stub

# Public URL of the Next app. Email links (verify, reset) point here.
APP_ORIGIN=http://localhost:3000

# Email over SMTP (Mailpit in dev: host mailpit, port 1025, no auth, no TLS).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_STARTTLS=false
SMTP_FROM=Leafy <no-reply@leafy.local>

# S3 compatible storage (MinIO in dev). S3_ENDPOINT_URL is what the API connects to,
# S3_PUBLIC_ENDPOINT is the host browsers use (presigned URLs and catalog images).
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SCANS_BUCKET=leafy-scans
S3_CATALOG_BUCKET=leafy-catalog

# Google sign in. Leave the client id empty and set GOOGLE_MOCK=1 to use the local mock
# (refused when ENV=prod). GOOGLE_REDIRECT_URI may list several URIs separated by commas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_MOCK=0

# Account rules.
VERIFY_RESEND_COOLDOWN_SECONDS=60
FRESH_SESSION_SECONDS=600
