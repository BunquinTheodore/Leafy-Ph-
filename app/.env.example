# App local env (server only values; never prefix secrets with NEXT_PUBLIC_).
API_INTERNAL_URL=http://localhost:8000
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_PREFIX=
MAX_UPLOAD_BYTES=8388608

# Public object storage host (the same value as the API's S3_PUBLIC_ENDPOINT). Browsers load the
# presigned scan photos and the catalog images from it, so its origin is added to the CSP img-src.
# Leave it empty only if no image is served from a separate host. Only a plain http(s) origin is used.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Google sign in through Firebase Auth. The browser signs in with the Firebase JS SDK and Next
# forwards the ID token to the API, which verifies it with Google's public certificates. There is
# no client secret and no service account here. These values are PUBLIC identifiers (they ship in
# the browser bundle) but still live in the environment. They are inlined at BUILD time, so a
# change needs a rebuild. Copy them from Firebase console > Project settings > Your apps > Web app.
# An empty NEXT_PUBLIC_FIREBASE_API_KEY disables the Google button. The API needs the matching
# FIREBASE_PROJECT_ID (see api/.env.example). Do not add Firebase Analytics (no measurement id).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Fake Google sign in for tests and local development only (tokens signed with a test key that the
# API trusts only when its own GOOGLE_MOCK=1). Both are refused when ENV=prod or COOKIE_SECURE=true.
# NEXT_PUBLIC_AUTH_MOCK is read at build time; ?mock_google_email=a@b.co on /login picks the identity.
GOOGLE_MOCK=0
NEXT_PUBLIC_AUTH_MOCK=0

# Client address for per IP rate limits. Number of reverse proxies in front of Next whose
# X-Forwarded-For entry is trusted (0 = none, the header is ignored and never forwarded).
# Behind one proxy that appends the real client address (nginx, Caddy, a load balancer) use 1.
# Never raise it above the real number of proxies: a client could then pick its own address.
TRUSTED_PROXY_HOPS=0
