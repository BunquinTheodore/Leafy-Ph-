# API local env. The repo root .env.example documents every variable; this is a convenience
# subset for running the API directly with `uv run uvicorn app.main:app --reload`.
DATABASE_URL=postgresql+asyncpg://leafy:change-me-dev-only@localhost:5433/leafy
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
ML_SERVICE=stub


# Path to ML model itself
MODEL_PATH=app/services/ml/models/mobilenetv2_plant.pth

# Allow loading pickled models. Note that this allows arbitrary code execution.
ML_ALLOW_PICKLE=true

# Method for preprocessing the image (crop | squash | pad | strict)
# Note that they may have different accuracies depending on input type
ML_RESIZE_MODE=crop

# ML: leaf gate (CLIP)
# Reject non-leaf images as plant=unknown/disease=unknown before the classifier runs.
# Set to false to skip the gate entirely.
ML_LEAF_GATE=true

# Minimum leaf probability (0-1) for an image to pass the gate.
# Lower = more permissive (fewer real leaves rejected, more junk gets through).
ML_GATE_THRESHOLD=0.5

# Hugging Face model id for the gate. Downloaded automatically on first startup
# (~600 MB for the default) and cached afterwards.
ML_GATE_MODEL=openai/clip-vit-base-patch32

# Where to cache the downloaded CLIP weights. Leave empty for the default
# Hugging Face cache (~/.cache/huggingface). In Docker, point this at a mounted volume.
ML_GATE_CACHE_DIR=

# Never touch the network; load CLIP from the cache only.
# Set to true in production once the model has been downloaded.
ML_GATE_OFFLINE=false


# S3 compatible storage (MinIO in dev). S3_ENDPOINT_URL is what the API connects to,
# S3_PUBLIC_ENDPOINT is the host browsers use (presigned URLs and catalog images).
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SCANS_BUCKET=leafy-scans
S3_CATALOG_BUCKET=leafy-catalog

# Google sign in via Firebase Auth. The browser signs in with the Firebase JS SDK and the API only
# verifies the Firebase ID token against Google's public certificates (no client secret, no
# service account). Empty FIREBASE_PROJECT_ID disables Google sign in. GOOGLE_MOCK=1 accepts the
# HS256 test token the web builds itself with NEXT_PUBLIC_AUTH_MOCK=1 (kid leafy-mock, issuer and
# audience taken from FIREBASE_PROJECT_ID, default leafy-mock). The signing key is public, so it also
# needs ALLOW_INSECURE_MOCKS=1 and is refused unless ENV is dev or test. Never set either on a server.
FIREBASE_PROJECT_ID=
GOOGLE_MOCK=0
ALLOW_INSECURE_MOCKS=0

# Account rules. The API sends no email. A session started by a Google sign in newer than
# FRESH_SESSION_SECONDS may set a new password without the current one (the recovery path), and a
# Google only account must also be this fresh to delete itself.
FRESH_SESSION_SECONDS=600

# Number of trusted proxies in front of the API. Next sends one validated client address in
# X-Forwarded-For, so set this to 1 when the API sits behind the Next server. With 0 every
# request is rate limited under the Next server address, so one user can lock out everyone.
TRUSTED_PROXY_HOPS=0
