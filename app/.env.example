# App local env (server only values; never prefix secrets with NEXT_PUBLIC_).
API_INTERNAL_URL=http://localhost:8000
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_PREFIX=
MAX_UPLOAD_BYTES=8388608

# Google sign in (the redirect legs run in Next; the code exchange and the secret live in the API).
# Leave GOOGLE_CLIENT_ID empty and set GOOGLE_MOCK=1 to use the built in fake provider.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_MOCK=1
