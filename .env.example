# Leafy environment. Copy to .env and change every secret. Never commit .env.
# Names match docker-compose.yml and the plan. Values below are local dev placeholders only.

# --- Database (api) ---
POSTGRES_USER=leafy
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=leafy
DATABASE_URL=postgresql+asyncpg://leafy:change-me-dev-only@postgres:5432/leafy

# --- Auth (api) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_FAMILY_MAX_DAYS=90
REFRESH_GRACE_SECONDS=10
VERIFY_EMAIL_TTL_HOURS=24
RESET_PASSWORD_TTL_HOURS=1

# --- Email (SMTP; Mailpit in dev) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=Leafy <no-reply@leafy.local>

# --- Object storage (S3 compatible; MinIO in dev) ---
S3_ENDPOINT_URL=http://minio:9000
# Host the browser can reach, used to sign presigned URLs
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=leafy-dev-access
S3_SECRET_KEY=leafy-dev-secret-change-me
S3_SCANS_BUCKET=leafy-scans
S3_CATALOG_BUCKET=leafy-catalog
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-change-me

# --- ML ---
# stub (raises NotImplementedError -> 503 ml_unavailable) or pkg.module:ClassName
ML_SERVICE=stub

# --- Limits ---
MAX_UPLOAD_BYTES=8388608
# Max stored scans per user
SCAN_QUOTA=500

# --- Web (app) <-> API wiring ---
# Server only URL the Next.js server uses to reach FastAPI (never exposed to the browser)
API_INTERNAL_URL=http://api:8000
# Public origin of the web app (used for Origin checks and redirects)
APP_ORIGIN=http://localhost:3000
# true in production (HTTPS). Enables Secure cookies
COOKIE_SECURE=false
# "__Host-" in production (requires Secure + Path=/), empty in local http dev
COOKIE_PREFIX=
# Client address for per IP rate limits (register, login, Google, password reset).
# WEB_TRUSTED_PROXY_HOPS: reverse proxies in front of Next (nginx, Caddy, a load balancer) that
# append the real client address to X-Forwarded-For. Use 1 behind one such proxy, 0 when Next is
# exposed directly (the header is then ignored). Never set it above the real number of proxies.
WEB_TRUSTED_PROXY_HOPS=0
# API_TRUSTED_PROXY_HOPS: leave at 1. Next forwards one validated client address to the API.
# At 0 every user shares the Next server address and one person can rate limit everyone.
API_TRUSTED_PROXY_HOPS=1

# --- Google sign in (API holds the secret; Next never sees it) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# 1 = built in fake Google provider (local dev only; refused when ENV=prod). Keep 0 in production.
GOOGLE_MOCK=0

