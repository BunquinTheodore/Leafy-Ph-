# App local env (server only values; never prefix secrets with NEXT_PUBLIC_).
API_INTERNAL_URL=http://localhost:8000
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_PREFIX=
MAX_UPLOAD_BYTES=8388608

# Public object storage host (the same value as the API's S3_PUBLIC_ENDPOINT). Browsers load the
# presigned scan photos and the catalog images from it, so its origin is added to the CSP img-src.
# Leave it empty only if no image is served from a separate host. Only a plain http(s) origin is used.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Google sign in (the redirect legs run in Next; the code exchange and the secret live in the API).
# Leave GOOGLE_CLIENT_ID empty and set GOOGLE_MOCK=1 to use the built in fake provider.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_MOCK=1

# Client address for per IP rate limits. Number of reverse proxies in front of Next whose
# X-Forwarded-For entry is trusted (0 = none, the header is ignored and never forwarded).
# Behind one proxy that appends the real client address (nginx, Caddy, a load balancer) use 1.
# Never raise it above the real number of proxies: a client could then pick its own address.
TRUSTED_PROXY_HOPS=0
